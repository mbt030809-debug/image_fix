<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.imagefix.editor">

    <!-- Android 9 이하에서만 갤러리 저장에 필요. 10+ 는 MediaStore 로 권한 없이 저장. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 인터넷은 AI 기능 요청(AiClient: 고정된 https 서버 api.cloudflare.com · api-inference.modelscope.cn · generativelanguage.googleapis.com · router.huggingface.co,
         결과 이미지는 허용된 도메인에서만)에만 쓴다. WebView 의 웹 콘텐츠는 CSP + 외부 요청 403 으로 인터넷에 직접 접근할 수 없다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AI 요청이 길어서(수십 초~수 분) 앱을 백그라운드로 보내도 이어지게: 진행 중 알림이 뜨는 포그라운드 서비스(dataSync) + 끝났을 때 알림(Android 13+ 알림 권한).
         이 서비스는 통신을 하지 않고 프로세스만 살려 둔다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 앱 안에서 새 버전을 설치(업데이트)하려고: GitHub 의 release/latest.json 을 확인하고 APK 를 받아 PackageInstaller 로 설치한다. 같은 서명키가 아니면 설치되지 않는다. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 갤러리/파일앱의 "편집", "연결 앱", "공유" 목록에 표시 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <service
            android:name=".AiService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
